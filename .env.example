# Copia este archivo a .env (local) y completa los valores. NUNCA subas .env a GitHub.

# Proyecto Supabase (Settings > API)
SUPABASE_URL=
# Clave pública (anon): segura para el navegador porque RLS protege los datos.
SUPABASE_ANON_KEY=

# NO colocar aquí la clave service_role. Si algún día se necesita, va SOLO como
# secreto del servidor (Cloudflare: wrangler secret put SUPABASE_SERVICE_ROLE_KEY).
